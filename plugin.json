{
  "id": "appview",
  "name": "애플리케이션",
  "description": "embed protocol을 말하는 애플리케이션의 화면을 연결 plugin에 준다. 연결 plugin은 extension point appview.surface의 공유 module로 자기 카드에 애플리케이션을 띄운다.",
  "extends": {
    "surface": {
      "version": "1.0.0",
      "schema": {
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          }
        }
      },
      "modules": {
        "surface": "ui/appview.js",
        "input": "ui/input.js",
        "events": "ui/events.js"
      }
    }
  }
}
